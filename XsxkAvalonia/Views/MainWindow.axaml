<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XsxkAvalonia.ViewModels"
        xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        x:Class="XsxkAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="南信大选课助手 v2.1"
        Width="1360" Height="920" MinWidth="1160" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F2"
        FontFamily="avares://XsxkAvalonia/Assets/Fonts/#HarmonyOS Sans SC"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,6,*">

        <!-- ============ 自绘标题栏（可拖动 / 双击最大化，透明底透出纹理） ============ -->
        <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="南信大选课助手" FontSize="14" FontWeight="Black"/>
                    <TextBlock Text="// NUIST XSXK HELPER v2.1" FontSize="10" Opacity="0.45"
                               FontFamily="Consolas" FontWeight="Bold"
                               VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="BtnMin" Classes="ef-win">
                        <Rectangle Width="9" Height="2.4"
                                   Fill="{Binding $parent[Button].Foreground}"/>
                    </Button>
                    <Button x:Name="BtnMax" Classes="ef-win">
                        <Path Data="{StaticResource IcWinMax}" Classes="ef-ic" Width="13" Height="13"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                    </Button>
                    <Button x:Name="BtnClose" Classes="ef-win">
                        <Path Data="{StaticResource IcWinClose}" Classes="ef-ic" Width="13" Height="13"
                              Stroke="{Binding $parent[Button].Foreground}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 十字准星网格背景（覆盖整个窗口，含标题栏） -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <DrawingBrush TileMode="Tile" DestinationRect="0,0,56,56" SourceRect="0,0,56,56" Stretch="None">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#1E212121" Geometry="M26,20 v16 M20,26 h16"/>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <!-- 等高线装饰纹理（右下角大幅，覆盖整个窗口，透过半透明卡片与标题栏可见） -->
        <Image Grid.Row="0" Grid.RowSpan="3" Source="avares://XsxkAvalonia/Assets/contour.png"
               Width="1500" Opacity="0.10" Stretch="Uniform" IsHitTestVisible="False"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

        <!-- 顶部色条（在标题文字下方）：品红 / 黄 / 绿 + 延伸至边缘的黑粗条 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Border Width="72" Background="#FF2D92"/>
            <Border Width="72" Background="#FEFE2C"/>
            <Border Width="72" Background="#00E0A0"/>
            <Border HorizontalAlignment="Stretch" Background="#212121"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,480" Margin="14,10,14,12">

            <!-- ============ 左列：状态 / 连接+抢课设置 / 课程列表（窗口拉宽时仅本列变宽） ============ -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,12,0">

                <!-- 状态监控 -->
                <Border Classes="ef-card" Grid.Row="0" Padding="18,14" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <Border BorderBrush="#212121" BorderThickness="0,0,0,1"
                                    HorizontalAlignment="Left" Padding="0,0,0,2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="9" Height="9" Background="#FEFE2C" VerticalAlignment="Center"/>
                                    <TextBlock Text="状态监控" FontSize="17" FontWeight="Black"/>
                                    <TextBlock Text="// STATUS" FontSize="11" Opacity="0.45" FontWeight="Bold"
                                               FontFamily="Consolas" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                </StackPanel>
                            </Border>
                            <Border Height="3" Background="#212121" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding BrowserBrush}"/>
                                <TextBlock Text="内置浏览器" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BrowserStatus}" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding TokenBrush}"/>
                                <TextBlock Text="登录凭证" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TokenStatus}" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding WsBrush}"/>
                                <TextBlock Text="结果推送 WS" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding WsStatus}" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding GrabBrush}"/>
                                <TextBlock Text="抢课任务" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding GrabStatus}" VerticalAlignment="Center"
                                           FontWeight="Black" Foreground="{Binding GrabBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                            <TextBlock Text="{Binding BatchTail}" FontSize="12" Opacity="0.75" HorizontalAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding NetText}" FontSize="12" Opacity="0.6" HorizontalAlignment="Right"/>
                            <TextBlock Text="作者：太微垣，使用 Kimi K3 制作" FontSize="11" Opacity="0.5" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 连接 + 抢课设置 -->
                <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="0,0,0,12">

                    <Border Classes="ef-card" Grid.Column="0" Padding="18,14">
                        <StackPanel Spacing="10">
                            <StackPanel>
                                <Border BorderBrush="#212121" BorderThickness="0,0,0,1"
                                        HorizontalAlignment="Left" Padding="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="9" Height="9" Background="#FEFE2C" VerticalAlignment="Center"/>
                                        <TextBlock Text="连接" FontSize="17" FontWeight="Black"/>
                                        <TextBlock Text="// CONNECT" FontSize="11" Opacity="0.45" FontWeight="Bold"
                                                   FontFamily="Consolas" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </Border>
                                <Border Height="3" Background="#212121" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Command="{Binding OpenBrowserCommand}"
                                    Classes="ef-primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource IcGlobe}" Classes="ef-ic" Width="16" Height="16"
                                          Stroke="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="内置浏览器登录" FontWeight="Black"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IcWarn}" Classes="ef-ic" Width="15" Height="15"
                                      Stroke="#B45309" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Text="抢课期间请勿关闭内置浏览器，所有请求都经过它"
                                           Foreground="#B45309" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Command="{Binding RefreshBatchCommand}"
                                    Classes="ef" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource IcRefresh}" Classes="ef-ic" Width="15" Height="15"
                                          Stroke="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="刷新轮次/类别" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="AdvToggle" Classes="ef"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="高级设置" FontWeight="SemiBold"/>
                                    <Path Data="{StaticResource IcArrowDown}" Classes="ef-ic adv-arrow"
                                          Width="13" Height="13"
                                          Stroke="{Binding $parent[ToggleButton].Foreground}"/>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel IsVisible="{Binding IsChecked, ElementName=AdvToggle}"
                                        Spacing="8" Margin="0,0,0,0">
                                <CheckBox Content="记录浏览器请求（排障用，日志会刷屏）"
                                          IsChecked="{Binding DebugCapture}"/>
                                <Button Command="{Binding CheckTokenCommand}"
                                        Classes="ef" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <TextBlock Text="检查 token 有效期" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="ef-card" Grid.Column="2" Padding="18,14">
                        <StackPanel Spacing="10">
                            <StackPanel>
                                <Border BorderBrush="#212121" BorderThickness="0,0,0,1"
                                        HorizontalAlignment="Left" Padding="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="9" Height="9" Background="#FEFE2C" VerticalAlignment="Center"/>
                                        <TextBlock Text="抢课设置" FontSize="17" FontWeight="Black"/>
                                        <TextBlock Text="// SETTINGS" FontSize="11" Opacity="0.45" FontWeight="Bold"
                                                   FontFamily="Consolas" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </Border>
                                <Border Height="3" Background="#212121" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="轮次" FontSize="12" Opacity="0.7" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                                              HorizontalAlignment="Stretch" MaxDropDownHeight="360"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="开抢时间（留空=立即）" FontSize="12" Opacity="0.7" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding StartAtText}" Watermark="2026-07-30 11:00:00" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="类别" FontSize="12" Opacity="0.7" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding ClassTypes}" SelectedItem="{Binding SelectedClassType}"
                                              HorizontalAlignment="Stretch" MaxDropDownHeight="280"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="重试间隔（毫秒）" FontSize="12" Opacity="0.7" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding IntervalText}" Watermark="建议 200 - 500" FontFamily="Consolas"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="切换轮次/类别后自动获取类别与课程列表；选 XGKC 类别自动进入志愿模式。"
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 课程列表 -->
                <Border Classes="ef-card" Grid.Row="2" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,14,18,10">
                            <StackPanel Grid.Column="0">
                                <Border BorderBrush="#212121" BorderThickness="0,0,0,1"
                                        HorizontalAlignment="Left" Padding="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="9" Height="9" Background="#FEFE2C" VerticalAlignment="Center"/>
                                        <TextBlock Text="课程列表" FontSize="17" FontWeight="Black"/>
                                        <TextBlock Text="// COURSES" FontSize="11" Opacity="0.45" FontWeight="Bold"
                                                   FontFamily="Consolas" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </Border>
                                <Border Height="3" Background="#212121" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding FetchCoursesCommand}" Classes="ef">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource IcList}" Classes="ef-ic" Width="15" Height="15"
                                          Stroke="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="获取课程列表" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="18,0,18,8">
                            <Path Grid.Column="0" Data="{StaticResource IcSearch}" Classes="ef-ic"
                                  Width="16" Height="16" Stroke="#212121"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText}"
                                     Watermark="搜索（课程名/教师/时间…）"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="18,0,18,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IcBulb}" Classes="ef-ic" Width="14" Height="14"
                                      Stroke="#212121" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBlock Text="单击选中一行，点中间黄色箭头按钮加入志愿队列（也可双击该行直接加入）" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CourseCountText}" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                        <Grid Grid.Row="3" RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="3.4*,1.1*,2.2*,0.7*,0.7*"
                                  Background="#212121" Margin="18,0,18,0">
                                <TextBlock Grid.Column="0" Text="课程" FontWeight="Black" Padding="12,8" Foreground="#FEFE2C"/>
                                <TextBlock Grid.Column="1" Text="教师" FontWeight="Black" Padding="12,8" Foreground="#FEFE2C"/>
                                <TextBlock Grid.Column="2" Text="时间" FontWeight="Black" Padding="12,8" Foreground="#FEFE2C"/>
                                <TextBlock Grid.Column="3" Text="容量" FontWeight="Black" Padding="12,8" Foreground="#FEFE2C"/>
                                <TextBlock Grid.Column="4" Text="已选" FontWeight="Black" Padding="12,8" Foreground="#FEFE2C"/>
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding FilteredCourses}"
                                     SelectedItem="{Binding SelectedCourse}"
                                     Margin="18,0,18,14"
                                     Background="Transparent"
                                     BorderBrush="#212121" BorderThickness="2,0,2,2"
                                     DoubleTapped="CourseGrid_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CourseRow">
                                        <Grid ColumnDefinitions="3.4*,1.1*,2.2*,0.7*,0.7*">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Padding="12,6"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Teacher}" Padding="12,6"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Time}" Padding="12,6"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontSize="12" Opacity="0.8" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Cap}" Padding="12,6"
                                                       VerticalAlignment="Center" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Chosen}" Padding="12,6"
                                                       VerticalAlignment="Center" FontFamily="Consolas"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 右列：日志（上） / 志愿队列（下） ============ -->
            <Grid Grid.Column="1" RowDefinitions="*,*">

                <!-- 日志（保持不透明白卡） -->
                <Border Classes="ef-card" Grid.Row="0" Padding="0" Margin="0,0,0,12" Background="#FFFFFF">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,14,18,8">
                            <StackPanel Grid.Column="0">
                                <Border BorderBrush="#212121" BorderThickness="0,0,0,1"
                                        HorizontalAlignment="Left" Padding="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="9" Height="9" Background="#FEFE2C" VerticalAlignment="Center"/>
                                        <TextBlock Text="日志" FontSize="17" FontWeight="Black"/>
                                        <TextBlock Text="// LOG" FontSize="11" Opacity="0.45" FontWeight="Bold"
                                                   FontFamily="Consolas" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </Border>
                                <Border Height="3" Background="#212121" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnCopyLog" Classes="ef" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IcCopy}" Classes="ef-ic" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="复制日志" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Grid.Row="1" Background="#212121" Padding="12,8" Margin="18,0,18,14">
                            <Grid>
                                <Image Source="avares://XsxkAvalonia/Assets/contour-light.png"
                                       Opacity="0.10" Stretch="UniformToFill" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="LogScroll">
                                    <ItemsControl ItemsSource="{Binding Logs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LogLine">
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 志愿队列 -->
                <Border Classes="ef-card" Grid.Row="1" Padding="18,14">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border BorderBrush="#212121" BorderThickness="0,0,0,1"
                                        HorizontalAlignment="Left" Padding="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="9" Height="9" Background="#FEFE2C" VerticalAlignment="Center"/>
                                        <TextBlock Text="志愿队列" FontSize="17" FontWeight="Black"/>
                                        <TextBlock Text="// PREFERENCE" FontSize="11" Opacity="0.45" FontWeight="Bold"
                                                   FontFamily="Consolas" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </Border>
                                <Border Height="3" Background="#212121" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding MoveUpCommand}"
                                    Classes="ef" Padding="10,4" Margin="0,0,6,0">
                                <Path Data="{StaticResource IcArrowUp}" Classes="ef-ic" Width="14" Height="14"
                                      Stroke="{Binding $parent[Button].Foreground}"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding MoveDownCommand}"
                                    Classes="ef" Padding="10,4">
                                <Path Data="{StaticResource IcArrowDown}" Classes="ef-ic" Width="14" Height="14"
                                      Stroke="{Binding $parent[Button].Foreground}"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                            <Button Command="{Binding RemoveVolunteerCommand}" Classes="ef" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IcX}" Classes="ef-ic" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="移除所选" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearVolunteersCommand}" Classes="ef" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IcTrash}" Classes="ef-ic" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="清空全部" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Volunteers}" SelectedItem="{Binding SelectedVolunteer}"
                                 MinHeight="80" Background="Transparent"
                                 BorderBrush="#212121" BorderThickness="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VolunteerRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Num, StringFormat='{}{0}.'}" FontWeight="Black"
                                                   FontFamily="Consolas" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="3" Command="{Binding StartStopCommand}"
                                Classes="ef-primary" FontSize="17" Padding="0,11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock Text="{Binding StartButtonText}" FontWeight="Black"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 悬浮在课程列表与志愿队列之间的「加入志愿队列」按钮（骑跨两卡片边缘） -->
                <Button Grid.Row="1" Classes="ef-primary"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="42" Padding="0,16" Margin="-27,0,0,0"
                        Command="{Binding AddCourseCommand}"
                        CommandParameter="{Binding SelectedCourse}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IcArrowRight}" Classes="ef-ic" Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center"/>
                        <TextBlock Text="加入志愿队列" FontWeight="Black" FontSize="13"
                                   Width="18" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
