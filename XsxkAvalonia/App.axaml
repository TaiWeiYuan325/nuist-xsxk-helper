<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             x:Class="XsxkAvalonia.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <!-- ======== 自绘极简线条图标（24x24，描边风格） ======== -->
        <StreamGeometry x:Key="IcGlobe">M12,3.5 A8.5,8.5 0 1,0 12,20.5 A8.5,8.5 0 1,0 12,3.5 Z M3.5,12 h17 M12,3.5 A13,13 0 0,0 12,20.5 M12,3.5 A13,13 0 0,1 12,20.5</StreamGeometry>
        <StreamGeometry x:Key="IcRefresh">M19.5,12 a7.5,7.5 0 1,1 -2.2,-5.3 M17.5,3.5 v3.6 h-3.6</StreamGeometry>
        <StreamGeometry x:Key="IcKey">M8,16 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 M11.2,12.8 L20,4 M16.5,7.5 l2.5,2.5 M14,10 l2,2</StreamGeometry>
        <StreamGeometry x:Key="IcList">M4,6 h16 M4,12 h16 M4,18 h10</StreamGeometry>
        <StreamGeometry x:Key="IcSearch">M10.5,4.5 a6,6 0 1,0 0.01,0 M14.8,14.8 L20,20</StreamGeometry>
        <StreamGeometry x:Key="IcBulb">M12,3.5 a5.5,5.5 0 0,1 3.2,10 c-.7.5-1.2,1.4-1.2,2.3 h-4 c0,-.9 -.5,-1.8 -1.2,-2.3 a5.5,5.5 0 0,1 3.2,-10 Z M10,18.8 h4 M10.5,21.5 h3</StreamGeometry>
        <StreamGeometry x:Key="IcRocket">M12,2.5 c2.8,1.9 4.3,5.2 4.3,8.7 l-2.4,2.4 h-3.8 l-2.4,-2.4 c0,-3.5 1.5,-6.8 4.3,-8.7 Z M9.6,14.2 L7.5,20.5 M14.4,14.2 L16.5,20.5 M12,7.5 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0</StreamGeometry>
        <StreamGeometry x:Key="IcStop">M6.5,6.5 h11 v11 h-11 Z</StreamGeometry>
        <StreamGeometry x:Key="IcWarn">M12,3.5 L21.5,20 H2.5 Z M12,9.5 v4.5 M12,16.8 v0.3</StreamGeometry>
        <StreamGeometry x:Key="IcX">M5.5,5.5 L18.5,18.5 M18.5,5.5 L5.5,18.5</StreamGeometry>
        <StreamGeometry x:Key="IcCopy">M8.5,8.5 h11 v11 h-11 Z M15.5,8.5 v-4 h-11 v11 h4</StreamGeometry>
        <StreamGeometry x:Key="IcTrash">M4,6.5 h16 M9.5,6.5 v-3 h5 v3 M6.5,6.5 l1,14 h9 l1,-14 M10,10.5 v6.5 M14,10.5 v6.5</StreamGeometry>
        <StreamGeometry x:Key="IcArrowUp">M12,19.5 v-15 M5.5,11 L12,4.5 L18.5,11</StreamGeometry>
        <StreamGeometry x:Key="IcArrowDown">M12,4.5 v15 M5.5,13 L12,19.5 L18.5,13</StreamGeometry>
        <StreamGeometry x:Key="IcArrowRight">M4.5,12 h15 M13,5.5 L19.5,12 L13,18.5</StreamGeometry>
        <StreamGeometry x:Key="IcWinMin">M7,17 h10</StreamGeometry>
        <StreamGeometry x:Key="IcWinMax">M7.5,7.5 h9 v9 h-9 Z</StreamGeometry>
        <StreamGeometry x:Key="IcWinClose">M7,7 L17,17 M17,7 L7,17</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Light" PrimaryColor="Amber" SecondaryColor="Teal" />

        <!-- ======== 终末地工业风（v2.1）======== -->
        <!-- 主题色：亮黄 #FEFE2C / 重黑 #212121 -->

        <!-- 线条图标基础 -->
        <Style Selector="Path.ef-ic">
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <!-- 直角黑边卡片（70% 不透明白，透出底层纹理） -->
        <Style Selector="Border.ef-card">
            <Setter Property="Background" Value="#B3FFFFFF"/>
            <Setter Property="BorderBrush" Value="#212121"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- 普通按钮：白底黑框，悬停变黄 -->
        <Style Selector="Button.ef">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#212121"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ef:pointerover">
            <Setter Property="Background" Value="#FEFE2C"/>
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style Selector="Button.ef:pressed">
            <Setter Property="Background" Value="#212121"/>
            <Setter Property="Foreground" Value="#FEFE2C"/>
        </Style>

        <!-- 主按钮：黄底黑字黑框，悬停反色 -->
        <Style Selector="Button.ef-primary">
            <Setter Property="Background" Value="#FEFE2C"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#212121"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ef-primary:pointerover">
            <Setter Property="Background" Value="#212121"/>
            <Setter Property="Foreground" Value="#FEFE2C"/>
        </Style>
        <Style Selector="Button.ef-primary:pressed">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="#FEFE2C"/>
        </Style>

        <!-- 无边框窗口的控制按钮：描边小方块，悬停反色 -->
        <Style Selector="Button.ef-win">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#212121"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ef-win:pointerover">
            <Setter Property="Background" Value="#212121"/>
            <Setter Property="Foreground" Value="#FEFE2C"/>
        </Style>

        <!-- 窗口按钮内的图标线条加粗 -->
        <Style Selector="Button.ef-win Path.ef-ic">
            <Setter Property="StrokeThickness" Value="2.6"/>
        </Style>

        <!-- 高级设置折叠按钮：与 Button.ef 同风格（Material 的 ToggleButton 默认样式需显式覆盖） -->
        <Style Selector="ToggleButton.ef">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#212121"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.ef:pointerover">
            <Setter Property="Background" Value="#FEFE2C"/>
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style Selector="ToggleButton.ef:checked">
            <Setter Property="Background" Value="#212121"/>
            <Setter Property="Foreground" Value="#FEFE2C"/>
        </Style>
        <Style Selector="ToggleButton.ef:checked:pointerover">
            <Setter Property="Background" Value="#212121"/>
            <Setter Property="Foreground" Value="#FEFE2C"/>
        </Style>
        <Style Selector="ToggleButton.ef:checked Path.adv-arrow">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>

        <!-- 列表选中：亮黄底黑字 -->
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#FEFE2C"/>
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#80FEFE2C"/>
        </Style>
    </Application.Styles>
</Application>
